default_platform(:ios)

# HyperFit Fastfile.
#
# Auth: Apple ASC API key sourced from ~/.claude/credentials/apple/env
# (one user-level key covers every Hyperfocused-portfolio app, see the
# /ship-ios skill). Never use Apple ID password — falls back to 2FA and
# overwrites pending drafts.
#
# Lanes:
#   * metadata — upload App Store text + screenshots only (no IPA upload,
#                no submission). Safe to run repeatedly while iterating
#                copy + screenshots before pulling the trigger.
#   * submit   — upload metadata + push for App Store review. Runs after
#                an EAS build is already in TestFlight.
#
# Build + IPA upload still happens via EAS (`eas build` + `eas submit`).
# Fastlane only owns the App Store metadata side here.

ASC_KEY_ID      = ENV["ASC_KEY_ID"]
ASC_ISSUER_ID   = ENV["ASC_ISSUER_ID"]
ASC_KEY_PATH    = ENV["ASC_KEY_FILEPATH"]

def asc_api_key
  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_PATH,
    duration: 1200,
    in_house: false,
  )
end

ANDROID_SA_JSON = File.expand_path("~/.claude/credentials/google-play/hyperfit-service-account.json")
ANDROID_PACKAGE = "com.hyperfocused.hyperfit"

platform :android do
  desc "Upload Play Store metadata + screenshots (no AAB upload)"
  lane :metadata do
    supply(
      package_name: ANDROID_PACKAGE,
      json_key: ANDROID_SA_JSON,
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: false,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      validate_only: false,
    )
  end

  desc "Dry-run metadata validation (no Play Console writes)"
  lane :metadata_validate do
    supply(
      package_name: ANDROID_PACKAGE,
      json_key: ANDROID_SA_JSON,
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: true,
      validate_only: true,
    )
  end
end

platform :ios do
  desc "Upload metadata + screenshots (no submit)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      submit_for_review: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Upload metadata + submit for App Store review"
  lane :submit do
    # NOTE: omit `automatic_release` — passing it triggers fastlane#16679
    # ("releaseType can not be modified"). Toggle release type in the ASC UI.
    deliver(
      api_key: asc_api_key,
      submit_for_review: true,
      force: true,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
